# Ambiente activo: local para XAMPP o development para InfinityFree.
# Si no existe /.env, el sistema usa development por defecto.
APP_ENV=local

# LOCAL / XAMPP
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=clinica
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Para InfinityFree no es necesario copiar aqui las credenciales del demo:
# si APP_ENV=development, api/db.php usa la configuracion de InfinityFree
# incluida para este entorno. Si el hosting cambia las credenciales, puede
# sobrescribirlas con DB_HOST/DB_NAME/DB_USER/DB_PASS en /.env.

# Vacio para dominio raiz; use /clinica si despliega en subcarpeta.
APP_BASE_PATH=

# Envio de correo (confirmacion y recordatorio de citas). Sin estos valores
# el envio se desactiva solo (no rompe el agendamiento).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=
SMTP_PASS=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Clinica Estandar

# Envio de WhatsApp. Opciones: mock (no envia nada, solo registra el intento),
# twilio, meta.
WHATSAPP_PROVIDER=mock
WHATSAPP_DEFAULT_COUNTRY_CODE=593

# Twilio WhatsApp API
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_CONTENT_SID_CONFIRMATION=
TWILIO_CONTENT_SID_REMINDER=

# Meta WhatsApp Cloud API
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_ACCESS_TOKEN=
META_TEMPLATE_NAME_CONFIRMATION=
META_TEMPLATE_NAME_REMINDER=
META_TEMPLATE_LANGUAGE=es

# Zona horaria de la clinica.
APP_TIMEZONE=America/Guayaquil

# Secreto para invocar api/cron/reminders.php por HTTP.
CRON_SECRET=
