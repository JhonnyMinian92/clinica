DB_HOST=sql206.infinityfree.com
DB_PORT=3306
DB_NAME=if0_42682038_clinical
DB_USER=if0_42682038
DB_PASS=CAMBIAR_POR_LA_CONTRASENA_REAL
DB_CHARSET=utf8mb4
# Vacio para dominio raiz; use /clinica si despliega en subcarpeta.
APP_BASE_PATH=

# Envio de correo (confirmacion y recordatorio de citas). Sin estos valores
# el envio se desactiva solo (no rompe el agendamiento).
# Local/XAMPP con Gmail: use una "contrasena de aplicacion" de una cuenta con 2FA.
# Produccion (cPanel/EcuaHosting): use el SMTP del propio hosting.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=
SMTP_PASS=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Clinica Estandar

# Envio de WhatsApp. Opciones: mock (no envia nada, solo registra el intento),
# twilio, meta. Numero de telefono asumido sin codigo de pais -> se antepone
# este codigo (Ecuador = 593) al formatear para WhatsApp.
WHATSAPP_PROVIDER=mock
WHATSAPP_DEFAULT_COUNTRY_CODE=593

# Twilio WhatsApp API (requiere cuenta Twilio + plantillas de WhatsApp
# aprobadas por Meta para confirmacion y recordatorio).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_CONTENT_SID_CONFIRMATION=
TWILIO_CONTENT_SID_REMINDER=

# Meta WhatsApp Cloud API (alternativa a Twilio; active con
# WHATSAPP_PROVIDER=meta cuando exista cuenta de Meta Business verificada
# y plantillas aprobadas).
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_ACCESS_TOKEN=
META_TEMPLATE_NAME_CONFIRMATION=
META_TEMPLATE_NAME_REMINDER=
META_TEMPLATE_LANGUAGE=es

# Zona horaria de la clinica. Se aplica en todo el sistema (web y cron) para
# que los recordatorios se disparen en el momento correcto sin depender de
# la configuracion de PHP del hosting.
APP_TIMEZONE=America/Guayaquil

# Secreto para invocar api/cron/reminders.php por HTTP (wget/curl desde el
# panel de hosting). La ejecucion por CLI/cron del sistema no lo necesita.
CRON_SECRET=
