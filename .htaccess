Options -Indexes

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Never expose local configuration, internal documentation or repository data.
  RewriteRule ^(?:\.env|\.gitignore)$ - [F,L,NC]
  RewriteRule ^(?:context\.md|pendiente\.md)$ - [F,L,NC]
  RewriteRule ^api/db\.local(?:\.php|\.example\.php)$ - [F,L,NC]
  RewriteRule ^api/storage(?:/|$) - [F,L,NC]
  RewriteRule ^database(?:/|$) - [F,L,NC]
</IfModule>

<FilesMatch "^(?:\.env|\.gitignore|.*\.local\.php)$">
  Require all denied
</FilesMatch>
